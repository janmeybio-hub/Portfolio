<style>
  /* --- BULLETPROOF DUAL-LENS TOGGLE SYSTEM --- */

  /* 1. Default State: Show R&D, Hide Business completely */
  .lens-biz {
    display: none !important;
  }
  .lens-rd {
    display: block !important;
  }

  /* Fix for R&D Grids/Flex containers so they don't break when visible */
  div.lens-rd.grid { display: grid !important; }
  div.lens-rd.flex { display: flex !important; }

  /* 2. When Business Radio is Checked: Hide R&D, Show Business */
  #radio-biz:checked ~ * .lens-rd {
    display: none !important;
  }

  /* Show Business blocks */
  #radio-biz:checked ~ * .lens-biz {
    display: block !important;
  }

  /* Preserve grid and flex layouts for Business sections */
  #radio-biz:checked ~ * div.lens-biz.grid {
    display: grid !important;
  }
  #radio-biz:checked ~ * div.lens-biz.flex {
    display: flex !important;
  }

  /* 3. Dynamic Header Button Color Switches */
  #radio-rd:checked ~ * #btn-lens-rd {
    background-color: #0f172a !important;
    color: #ffffff !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;
